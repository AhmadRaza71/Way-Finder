{
  "name": "wayfinder",
  "version": "2.0.0",
  "description": "Dark navigation app powered by Google Maps Platform",
  "main": "main.js",
  "author": "Wayfinder",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --publish never" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.0.0" },
  "build": {
    "appId": "com.example.wayfinder",
    "productName": "Wayfinder",
    "files": ["main.js", "preload.js", "index.html", "build/icon.png"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
